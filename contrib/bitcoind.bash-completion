_garlicoind()
{
    local cur opts
    cur="${COMP_WORDS[COMP_CWORD]}"
    COMPREPLY=()
    opts=$(garlicoind -help 2>&1 | awk '$1 ~ /^-/ { sub(/=.*/, "="); print $1 }')
    COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
    if [[ ${#COMPREPLY[@]} -eq 1 && "${COMPREPLY[0]}" == *= ]]; then
        compopt -o nospace
    fi
}

complete -F _garlicoind garlicoind
