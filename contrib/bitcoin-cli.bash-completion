_garlicoin_cli()
{
    local cur opts commands
    cur="${COMP_WORDS[COMP_CWORD]}"
    COMPREPLY=()

    if [[ -z "$cur" || "$cur" == -* ]]; then
        opts=$(garlicoin-cli -help 2>&1 | awk '$1 ~ /^-/ { sub(/=.*/, "="); print $1 }')
    fi

    if [[ -z "$cur" || "$cur" =~ ^[a-z] ]]; then
        commands=$(garlicoin-cli help 2>/dev/null | awk '$1 ~ /^[a-z]/ { print $1 }')
    fi

    COMPREPLY=( $(compgen -W "$opts $commands" -- "$cur") )
    if [[ ${#COMPREPLY[@]} -eq 1 && "${COMPREPLY[0]}" == *= ]]; then
        compopt -o nospace
    fi
}

complete -F _garlicoin_cli garlicoin-cli
