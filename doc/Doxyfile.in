# Doxygen configuration for the maintained Garlicoin Core 0.18.x line.
# `configure` substitutes @PACKAGE_VERSION@ and writes doc/Doxyfile.

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Garlicoin Core"
PROJECT_NUMBER         = @PACKAGE_VERSION@
PROJECT_BRIEF          = "Maintained Garlicoin Core 0.18.x"

OUTPUT_DIRECTORY       = doc/doxygen
OUTPUT_LANGUAGE        = English
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

INPUT                   = src README.md doc
FILE_PATTERNS           = *.h *.hpp *.c *.cc *.cpp *.md
RECURSIVE               = YES
EXCLUDE                 = src/leveldb \
                          src/secp256k1 \
                          src/univalue \
                          src/crypto/ctaes \
                          doc/doxygen

EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = YES

MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES
USE_MDFILE_AS_MAINPAGE  = README.md

SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES

GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES

GENERATE_LATEX          = NO
GENERATE_MAN            = NO
GENERATE_XML            = NO
GENERATE_RTF            = NO

HAVE_DOT                = NO
